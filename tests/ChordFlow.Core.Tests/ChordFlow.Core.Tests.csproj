<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Plain net10.0: the tests target ChordFlow.Core, which is host-agnostic
         (no WinForms/WebView2). The "future cleanup" the old comment anticipated
         is done — the core-host-split moved Domain/Rendering/Features/Persistence
         into ChordFlow.Core, so the tests are no longer Windows-bound. -->
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="NetArchTest.Rules" Version="1.3.2" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\ChordFlow.Core\ChordFlow.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The 36 authored CAGED grips are a TEST-ONLY golden-oracle fixture (engine-derived-as-app-source IN8):
         the app no longer ships them (the engine derives `automatic` voicings); the oracle/coverage tests read
         them here. Copied next to the test assembly so OracleVoicings.Load() can read them at runtime. -->
    <Content Include="fixtures\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>