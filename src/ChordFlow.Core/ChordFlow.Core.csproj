<Project Sdk="Microsoft.NET.Sdk">

  <!-- ChordFlow.Core — the host-agnostic engine (Domain, Rendering, Features,
       Bridge DTOs, Persistence). Constraint C1: this project carries ZERO UI/host
       package references and no UseWindowsForms — the WinForms/WebView2 host lives
       in ChordFlow.Desktop. A plain net10.0 target keeps it portable so a future
       web/cross-platform host can reference it unchanged.
       See loom/chordflow/core-host-split/core-host-split-design.md. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- SQLite persistence (constraint C2: one offline file, no server). Persistence
         is host-agnostic, so it lives in Core — a future web host reuses it. Design is
         build-only (PrivateAssets=all) — needed for `dotnet ef migrations`, never
         shipped at runtime. See Persistence/ChordFlowDbContext.cs. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.8" />
    <!-- Security override (NU1903 / GHSA-2m69-gcr7-jv3q): EFCore.Sqlite 10.0.8 pulls the vulnerable
         native SQLitePCLRaw.lib.e_sqlite3 2.1.11 transitively. Pin the bundle at the patched 2.1.12
         (same 2.1.x line Microsoft.Data.Sqlite expects) so the direct reference wins over the
         transitive one and the advisory clears. Revisit/remove when EFCore.Sqlite ships a patched
         transitive. See loom/chordflow/sqlite-security-bump/. -->
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="2.1.12" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.8">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <!-- The default content pack (IN6) ships as data, not code: the bundle is copied next to the engine
         assembly and imported on first run via PackReader/PackImporter (see Features/Packs/DefaultPack.cs).
         CopyToOutputDirectory flows transitively to the Desktop host and the test project. -->
    <Content Include="Content\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
