<Project Sdk="Microsoft.NET.Sdk">

  <!-- ChordFlow.Desktop — the Windows host (WinForms + WebView2). The ONLY project
       that references a UI/host package; it depends on ChordFlow.Core for all engine,
       bridge-contract, and persistence logic (strict Desktop -> Core, constraint C2).
       See loom/chordflow/core-host-split/core-host-split-design.md. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Version>0.12.0</Version>
    <!-- Ship as ChordFlow.exe (not ChordFlow.Desktop.exe) — the end-user-facing name. -->
    <AssemblyName>ChordFlow</AssemblyName>
    <!-- App icon (the .exe + window icon) — committed at the repo root, shared with the docs. -->
    <ApplicationIcon>..\..\images\icon.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ChordFlow.Core\ChordFlow.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Official Microsoft WebView2 host (WinForms = windowed controller, which
         renders on this net10 + WebView2-149 stack where Photino's composition
         controller produced a black window). See loom/refs/photino-net-desktop-host-reference.md. -->
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.3296.44" />
  </ItemGroup>

  <!-- The WebView2 host serves the UI from disk via SetVirtualHostNameToFolderMapping
       (no HTTP server, C2). Copy the whole wwwroot tree — index.html, app.js,
       alphaTab.min.js, the Bravura music font, and the committed GM soundfont
       (wwwroot/soundfont/sonivox.sf2) — to the output (and to the publish folder, so the
       release zip carries it with no build-time download). Single-file publish keeps these
       as loose Content files beside the exe, which is required: the soundfont catalog
       auto-discovers .sf2 files from this folder at runtime. -->
  <ItemGroup>
    <Content Include="wwwroot\**\*" Exclude="wwwroot\.gitkeep">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>wwwroot\%(RecursiveDir)%(Filename)%(Extension)</Link>
    </Content>
  </ItemGroup>

</Project>
