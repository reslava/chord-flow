[Rr]elease/
x64/
x86/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
build/
bld/
[Ll]og/
[Ll]ogs/

# ----- Visual Studio / Rider / VS Code -----
.vs/
.vscode/
.idea/
*.user
*.suo
*.userosscache
*.sln.docstates
*.userprefs

# ----- NuGet -----
*.nupkg
*.snupkg
**/[Pp]ackages/*
!**/[Pp]ackages/build/
# The Loom weave folder is named "packages" — it is project docs, not a NuGet dir; keep it tracked.
!loom/packages/
!loom/packages/**
project.lock.json
project.fragment.lock.json
artifacts/

# ----- Test / coverage -----
[Tt]est[Rr]esult*/
*.coverage
*.coveragexml
coverage*.json
coverage*.xml
coverage*.info

# ----- ChordFlow runtime artifacts -----
# Local SQLite database (regenerated on run; definitions are seeded in code)
*.db
*.db-shm
*.db-wal
*.sqlite
# Soundfonts are bundled at build time, not committed (size + licensing)
src/**/wwwroot/soundfont/*.sf2
src/**/wwwroot/soundfont/*.sf3

# ----- Claude Code -----
.claude/settings.local.json

# ----- OS -----
.DS_Store
Thumbs.db
desktop.ini

# --- Internal Documentation (excluded from public repo) ---
docs/internal/