# ----- .NET build output -----
[Bb]in/
[Oo]bj/
[Dd]ebug/
[Rr]elease/
# Exception: loom/release/ is a Loom weave (Markdown workflow docs), not .NET build output —
# don't let the [Rr]elease/ rule above swallow it.
!loom/release/
!loom/release/**
x64/
x86/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
build/
bld/
[Ll]og/
[Ll]ogs/

# ----- Visual Studio / Rider / VS Code -----
.vs/
.vscode/
.idea/
*.user
*.suo
*.userosscache
*.sln.docstates
*.userprefs

# ----- NuGet -----
*.nupkg
*.snupkg
**/[Pp]ackages/*
!**/[Pp]ackages/build/
# The Loom weave folder is named "packages" — it is project docs, not a NuGet dir; keep it tracked.
!loom/packages/
!loom/packages/**
project.lock.json
project.fragment.lock.json
artifacts/

# ----- Test / coverage -----
[Tt]est[Rr]esult*/
*.coverage
*.coveragexml
coverage*.json
coverage*.xml
coverage*.info

# ----- ChordFlow runtime artifacts -----
# Local SQLite database (regenerated on run; definitions are seeded in code)
*.db
*.db-shm
*.db-wal
*.sqlite
# Soundfont banks are large + license-varied, so they stay out of the repo — EXCEPT the
# small default Sonivox font (Apache-2.0), which is committed so the build is hermetic (no
# build-time download). Any extra .sf2/.sf3 a user drops in is auto-discovered by the in-app
# picker and intentionally stays out of the repo.
src/**/wwwroot/soundfont/*.sf2
src/**/wwwroot/soundfont/*.sf3
!src/ChordFlow.Desktop/wwwroot/soundfont/sonivox.sf2

# ----- Claude Code -----
.claude/settings.local.json

# ----- OS -----
.DS_Store
Thumbs.db
desktop.ini

# --- Internal Documentation (excluded from public repo) ---
docs/internal/